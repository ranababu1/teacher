<?xml version="1.0" encoding="utf-8"?>
<!-- Auto-backup rules for Android 11 and below (full-backup-content).
     Same policy as data_extraction_rules.xml, which covers Android 12+:
     back up everything — learner progress above all — except the
     device-bound encrypted API keys and the key material that encrypts
     them. Paths are flutter_secure_storage 10.3.1's defaults
     (secure_api_key_store.dart constructs it with no options). -->
<full-backup-content>
    <!-- Encrypted API key values. -->
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <!-- Wrapped key material (decrypted only via this device's Keystore). -->
    <exclude domain="sharedpref" path="FlutterSecureStorageKeyStorage.xml" />
    <!-- Cipher/algorithm config markers. -->
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
    <!-- Legacy file from flutter_secure_storage <= 9.2.4 (Jetpack
         EncryptedSharedPreferences) — excluded for completeness. -->
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
</full-backup-content>