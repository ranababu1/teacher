<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+ (data extraction rules: cloud backup and
     device-to-device transfer). Everything is backed up by default — most
     importantly the learner's whole progress database at
     app_flutter/teacher_db.sqlite (the `file` domain). The only exclusions
     are the AI provider API keys and the key material that encrypts them:
     both are bound to this device's Android Keystore and can never be
     decrypted on restored hardware, so backing them up is pure risk, zero
     benefit. Paths are flutter_secure_storage 10.3.1's defaults
     (secure_api_key_store.dart constructs it with no options). -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Encrypted API key values. -->
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <!-- Wrapped key material (decrypted only via this device's Keystore). -->
        <exclude domain="sharedpref" path="FlutterSecureStorageKeyStorage.xml" />
        <!-- Cipher/algorithm config markers. -->
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
        <!-- Legacy file from flutter_secure_storage <= 9.2.4 (Jetpack
             EncryptedSharedPreferences) — excluded for completeness. -->
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Encrypted API key values. -->
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <!-- Wrapped key material (decrypted only via this device's Keystore). -->
        <exclude domain="sharedpref" path="FlutterSecureStorageKeyStorage.xml" />
        <!-- Cipher/algorithm config markers. -->
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
        <!-- Legacy file from flutter_secure_storage <= 9.2.4 (Jetpack
             EncryptedSharedPreferences) — excluded for completeness. -->
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>