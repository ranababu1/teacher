app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing — never commit. Local-only on dev machines; CI
# materializes both from GitHub Secrets (see .github/workflows/release.yml).
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# Widget Preview related
.widget_preview/

